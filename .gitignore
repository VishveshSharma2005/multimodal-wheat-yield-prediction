archive/

# ---------------------------------------------------------------------------
# Raw datasets - NOT redistributed via GitHub.
# See data/README.md for sources and download instructions.
# ---------------------------------------------------------------------------
data/raw/images/
data/raw/apy/*.pdf
data/raw/apy/*.xlsx
data/raw/apy/*.xls
data/raw/satellite/
data/raw/weather/
data/raw/drone/
data/raw/farm_logs/
data/raw/soil/

# Keep the small, hand-curated APY provenance CSVs and the folder READMEs
!data/raw/README.md
!data/raw/apy/README_APY_CSV.md
!data/raw/apy/*.csv

# ---------------------------------------------------------------------------
# Large derived data (regenerate with the pipeline; see docs/reproducibility.md)
# ---------------------------------------------------------------------------
data/processed/cnn_features/
data/processed/cnn_features.csv
data/processed/cnn_stage_features.csv
data/processed/stage_features_with_cnn.csv
data/processed/stage_features_with_split.csv
data/interim/cnn_dataset_split.csv
