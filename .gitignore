data/interim/weather_daily_points.csv
data/interim/satellite_observations.csv
reports/model_results/ml_selected_features.csv
reports/model_results/lstm_selected_features.csv
reports/model_results/lstm_summary.md
reports/feature_diagnosis_report.md

# ---------------------------------------------------------------------------
# Model artefacts.
# CNN .keras files are 9-88 MB each (~271 MB total) - excluded from normal Git
# history. See docs/models.md for how to obtain / place them.
# The small scikit-learn .joblib and PyTorch .pt artefacts ARE tracked.
# ---------------------------------------------------------------------------
models/cnn/
*.keras
*.h5
*.hdf5
*.ckpt
*.pb
saved_model/

